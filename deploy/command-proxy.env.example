# Proposed deployment template only; not installed, reserved, or enabled.
# Explicit PORT overrides the unchanged source default. Never use 8644 here:
# the live webhook wildcard listener occupies it. Recheck availability at install.
HOST=127.0.0.1
PORT=8647
COMMAND_PROXY_KEY=GENERATE_A_SEPARATE_RANDOM_VALUE_MATCHING_ONLY_THE_COMMAND_BFF_CLIENT
HERMES_API_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=THE_EXISTING_HERMES_API_SERVER_KEY
MAX_STREAM_SECONDS=1800
COMMAND_ANTHROPIC_ROUTES_ENABLED=false
# Offer every model the authenticated Codex/xAI subscriptions advertise (no API billing).
COMMAND_ADVERTISED_SUBSCRIPTION_ROUTES=false
COMMAND_OPENROUTER_FREE_ROUTES_ENABLED=false
COMMAND_HISTORY_BINDING_ENABLED=false

# Optional. Unset = off. When set (>=32 visible ASCII chars, distinct from every other key), each
# Command chat run carries `x-command-origin` so Hermes can return reminders to that chat.
# Hermes must hold the same value. See docs/cockpit/COMMAND-ORIGIN.md.
# COMMAND_ORIGIN_KEY=
