# Non-secret immutable image identities produced by `docker image inspect`.
JARVIS_COMMAND_APP_IMAGE=sha256:REPLACE_WITH_VERIFIED_APP_IMAGE_ID
JARVIS_COMMAND_READ_PROXY_IMAGE=sha256:REPLACE_WITH_VERIFIED_READ_PROXY_IMAGE_ID
# Local command-proxy proposal only; not consumed by the v0.1 release transaction.
JARVIS_COMMAND_COMMAND_PROXY_IMAGE=sha256:REPLACE_WITH_VERIFIED_COMMAND_PROXY_IMAGE_ID
