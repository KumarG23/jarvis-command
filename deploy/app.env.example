NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_VERSION=0.1.0
AUTH_MODE=cloudflare
CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CF_ACCESS_AUD=64_HEX_CHARACTERS
CF_ACCESS_EMAIL_SHA256=SHA256_OF_THE_LOWERCASE_APPROVED_EMAIL
CF_ACCESS_JWKS_FILE=/run/jarvis-command/cloudflare-jwks/certs.json
HERMES_API_BASE_URL=http://127.0.0.1:18642
HERMES_READ_PROXY_KEY=GENERATE_A_SEPARATE_RANDOM_VALUE
COMMAND_MODE=disabled
PUBLIC_ORIGIN=https://command.sharma-house.com
HERMES_COMMAND_API_BASE_URL=http://127.0.0.1:18643
# Generate separately from the read key; this is not an operational credential.
# Leave unset until the future approved command-mode transaction.
# HERMES_COMMAND_PROXY_KEY=
COMMAND_AUDIT_LOG_PATH=/var/lib/jarvis-command/audit/events.jsonl
ARTIFACTS_MODE=enabled
ARTIFACT_STORAGE_PATH=/var/lib/jarvis-command/artifacts
ARTIFACT_MAX_FILE_BYTES=10485760
ARTIFACT_MAX_TOTAL_BYTES=268435456
ARTIFACT_MAX_COUNT=10000
# Command default route when nothing else is chosen: provider/model/effort (Codex, xAI) or provider/model (OpenRouter :free).
COMMAND_DEFAULT_INFERENCE=openai-codex/gpt-6.1-sol/medium
# Scheduled runs (Hermes cron -> Command chat). Separate bearer-key listener; see docs/cockpit/SCHEDULED-RUNS.md.
SCHEDULED_RUNS_MODE=disabled
# SCHEDULED_RUNS_HOST=VM118_LAN_ADDRESS
# SCHEDULED_RUNS_PORT=8652
# SCHEDULED_RUNS_KEY=GENERATE_A_SEPARATE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
# SCHEDULED_RUNS_OWNER_ACTOR=64_HEX_ACTOR_FINGERPRINT_FROM_THE_AUDIT_LEDGER
