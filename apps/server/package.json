{
  "name": "@jarvis-command/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform node --target node22 --sourcemap --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "9.3.0",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.1",
    "jose": "6.2.10",
    "web-push": "3.6.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/web-push": "3.6.4",
    "fake-indexeddb": "6.2.6",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "vitest": "5.0.0"
  }
}
