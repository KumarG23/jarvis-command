{
  "name": "jarvis-command",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @jarvis-command/web && npm run build -w @jarvis-command/server && npm run build -w @jarvis-command/read-proxy && npm run build -w @jarvis-command/command-proxy",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test deploy/*.test.mjs && npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
